{
  "name": "mediatuna",
  "version": "1.20.0",
  "type": "module",
  "description": "Turn a home media archive into playable MP4 and MP3 without losing dates, tags, or already-finished work",
  "main": "index.js",
  "bin": {
    "mediatuna": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "convert": "node index.js",
    "test": "node --test test/**/*.test.js",
    "test:ffmpeg": "node --test test/integration/**/*.test.js",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "ship": "pnpm --dir site run ship"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "glob": "^11.0.0"
  },
  "keywords": [
    "video",
    "audio",
    "media",
    "converter",
    "ffmpeg",
    "nvenc",
    "batch",
    "metadata"
  ],
  "author": "Catalyst Forge LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/mediatuna.git"
  },
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/mediatuna/issues"
  },
  "homepage": "https://mediatuna.dev"
}
